{
  "name": "reprokit-learner-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node launch.mjs --dev",
    "start": "node launch.mjs",
    "dev:external": "node server.mjs",
    "start:external": "node server.mjs --dist",
    "lint": "npm run typecheck && node scripts/check.mjs",
    "test": "node --import tsx --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:filebrowser": "REPROKIT_RUN_FILEBROWSER_E2E=1 playwright test tests/e2e/filebrowser-live.spec.js",
    "test:e2e:dockerhub": "REPROKIT_RUN_DOCKERHUB_E2E=1 playwright test tests/e2e/filebrowser-dockerhub-live.spec.js",
    "test:e2e:dockerhub:go-git": "REPROKIT_RUN_DOCKERHUB_E2E=1 playwright test tests/e2e/go-git-dockerhub-live.spec.js",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "^0.28.2",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/noto-sans-jp": "5.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
