{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jphacks/sd_2601/main/schemas/lock-v1.schema.json",
  "title": "Reprokit Lockfile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lockVersion",
    "lab",
    "registry",
    "manifest",
    "source",
    "runtime",
    "images"
  ],
  "properties": {
    "lockVersion": {
      "const": 1
    },
    "lab": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?/[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "manifestPath"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "manifestPath": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "revision",
        "subdirectory",
        "composeSha256",
        "files"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^\\s/?#@]+(?:/[^\\s?#]*)?$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "subdirectory": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
        },
        "composeSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "platform",
        "resolvedComposeSha256"
      ],
      "properties": {
        "type": {
          "const": "docker-compose"
        },
        "platform": {
          "enum": [
            "linux/amd64",
            "linux/arm64"
          ]
        },
        "resolvedComposeSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "images": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "digest",
          "platform"
        ],
        "properties": {
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "platform": {
            "enum": [
              "linux/amd64",
              "linux/arm64"
            ]
          }
        }
      }
    },
    "checker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "digest",
        "platform"
      ],
      "properties": {
        "reference": {
          "const": "alpine:3"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "platform": {
          "enum": [
            "linux/amd64",
            "linux/arm64"
          ]
        }
      }
    }
  }
}
